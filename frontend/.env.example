# Base URL of the ELC backend API (no trailing slash).
# Local development: http://localhost:5000
# Production: set this in your deployment provider's environment variables,
# for example Vercel Project Settings -> Environment Variables.
# Never put backend secrets, JWT secrets, or database URLs in VITE_ variables.
VITE_API_BASE_URL=http://localhost:5000

# Confirmed production HTTPS origin used for canonical URLs, Open Graph URLs,
# the social preview image, and sitemap generation. No trailing slash.
# Leave blank until the production domain is confirmed. Do not use localhost here.
# Prefer setting this only in the Production environment, not Preview.
VITE_SITE_URL=
# On Vercel production builds, VERCEL_PROJECT_PRODUCTION_URL is used
# automatically when VITE_SITE_URL is blank. Preview deployments are excluded.

# Optional privacy-focused website analytics. Disabled unless both values are
# set and the production build is used. Analytics also stays off until a
# visitor allows it in the cookie preferences banner.
# VITE_ANALYTICS_ENABLED=true
# Domain reported to Plausible, for example elc.example.com. If omitted, the
# hostname from VITE_SITE_URL is used.
# VITE_ANALYTICS_DOMAIN=
