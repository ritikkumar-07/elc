
PORT=5000
NODE_ENV=development

# Exact frontend origin(s), comma-separated. No wildcards.
# Production example: https://your-frontend.example.com
FRONTEND_URL=http://localhost:5173

# Optional: add a second local-development origin, for example a LAN IP.
# LOCAL_NETWORK_IP=192.168.1.100

# Include the intended database name before the query string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Generate a random secret with at least 32 characters. Never commit the real value.
JWT_SECRET=

# Used only by scripts/createAdmin.js. Never commit real administrator credentials.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Cloudinary storage for study materials and topper photos. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: local directory for uploaded PDFs (defaults to backend/uploads).
# UPLOAD_DIR=uploads

# Production notes:
# - Set NODE_ENV=production so the auth cookie uses Secure + SameSite=None.
# - Serve the backend over HTTPS.
# - If the frontend and backend are on different sites, third-party cookie
#   blocking can still prevent persistent login. Prefer a same-site deployment
#   or a same-origin reverse proxy (for example /api on the frontend domain).
